# 复制为 .env 后填入真实凭据（.env 已被 .gitignore 排除，不会进仓库）
# 该文件仅作为字段说明，不含任何真实口令。

# 存储模式：mysql
STORE=mysql

# 填入实际开通的 MySQL 主机；此模板不代表已注册、连接或验收。
DB_HOST=你的数据库主机
DB_PORT=3306
DB_NAME=你的数据库名
DB_USER=你的用户名
DB_PASSWORD=你的口令

# 中间层监听端口
PORT=8787

# 公网部署时设置 NODE_ENV=production，并在平台环境变量中填写访问账号与独立口令。
# 本地不设置这两项时沿用原操作方式；不要把真实口令写入本模板。
# APP_ACCESS_USER=teacher
# APP_ACCESS_PASSWORD=在部署平台设置至少12字符的独立访问口令
